# ─── Database ─────────────────────────────────────────────────────────
# PostgreSQL connection string (e.g. from Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─── Cloudinary (File Storage) ────────────────────────────────────────
# Get these from: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── App ──────────────────────────────────────────────────────────────
NODE_ENV="development"
AUTH_SESSION_TTL_HOURS="168"
MAX_SCREENSHOT_UPLOAD_BYTES="10485760"
MAX_MAINTENANCE_PHOTO_UPLOAD_BYTES="10485760"
